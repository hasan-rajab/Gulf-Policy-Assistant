# NEXUS shared/local defaults
DEMO_MODE=true
AUTH_MODE=demo
JWT_SECRET=replace-this-for-any-non-local-use

# Demo identities: employee can query public/general content; knowledge_admin can ingest,
# evaluate, approve actions, and access restricted content. Replace in any shared demo.
DEMO_ACCOUNTS_JSON={"employee@gulfhorizon.local":{"password":"Demo123!","roles":["employee"],"departments":["general"]},"admin@gulfhorizon.local":{"password":"Admin123!","roles":["employee","knowledge_admin"],"departments":["general"]}}

# In IAP mode, resolve enterprise entitlements server-side from trusted identity data.
# Example only; do not trust client-supplied role/department headers.
ACCESS_PROFILES_JSON={"employee@example.com":{"roles":["employee"],"departments":["operations"]}}

# Google Cloud / Gemini
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3-flash-preview
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Retrieval: local | bigquery
VECTOR_BACKEND=local
BQ_DATASET=enterprise_rag
BQ_TABLE=policy_chunks
BQ_AUDIT_TABLE=audit_events
BQ_LOCATION=US
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_MULTIPLIER=4
MIN_RELEVANCE_SCORE=0.20

# API
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_APP_NAME=NEXUS Enterprise AI
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_DEMO_MODE=true
