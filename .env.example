# Shared/local defaults
DEMO_MODE=true
AUTH_MODE=demo
JWT_SECRET=replace-this-for-any-non-local-use
DEMO_USER_EMAIL=employee@gulfhorizon.local
DEMO_USER_PASSWORD=Demo123!

# Google Cloud / Gemini Enterprise Agent Platform
# Cloud Run deployment region stays separate from the Vertex AI / Gemini API location.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3-flash-preview
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Retrieval: local | bigquery
VECTOR_BACKEND=local
BQ_DATASET=enterprise_rag
BQ_TABLE=policy_chunks
BQ_LOCATION=US

# API
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.20

# Frontend
NEXT_PUBLIC_APP_NAME=Gulf Horizon Policy Assistant
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_DEMO_MODE=true
